# ═══════════════════════════════════════════════════════════════
# Nexus Research RAG — Environment Configuration
# Copy to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════════

# ── Application Environment ──────────────────────────────────
# Options: development | production | testing
ENV=development
LOG_LEVEL=INFO

# ── OpenAI API Configuration (Required) ─────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
MAX_COMPLETION_TOKENS=1024

# ── Security (Optional — leave blank for open access) ───────
# Set an API key to require X-API-Key header on all requests
API_KEY=
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LangSmith / LangChain Tracing (Optional) ────────────────
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGCHAIN_PROJECT=RAG-Evaluation

# ── Document Chunking & Retrieval Parameters ─────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=4

# ── Persistent Vector Store Configuration ────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=rag_documents
SEED_DOCUMENTS=false

# ── Upload Limits ────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
